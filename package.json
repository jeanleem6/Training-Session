    "@fullcalendar/list": "^6.1.17",
    "@fullcalendar/vue3": "^6.1.17",
    "@jsplumb/browser-ui": "^6.2.10",
    "@vueuse/core": "^13.3.0",
    "axios": "1.11.0",
    "dayjs": "^1.11.13",
    "element-plus": "2.11.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "^3.5.19",
    "vue-router": "^4.5.1"
  },
